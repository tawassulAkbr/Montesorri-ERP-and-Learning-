# PostgreSQL (Neon pooler connection string, sslmode=require)
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxx.region.aws.neon.tech/kinderguide?sslmode=require

# Auth
JWT_SECRET=replace-with-a-long-random-string-min-32-chars
JWT_EXPIRES_IN=7d

# Server
PORT=4000
NODE_ENV=development

# Email (Resend free tier). Leave RESEND_API_KEY empty to log emails to console instead of sending.
RESEND_API_KEY=
EMAIL_FROM=KinderGuide <onboarding@resend.dev>

# Frontend
FRONTEND_URL=http://localhost:5173
